                <string>Ingresos: $0.00</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignCenter</set>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QFrame" name="frameGastos">
            <layout class="QVBoxLayout">
             <item>
              <widget class="QLabel" name="lblTotalGastos">
               <property name="font">
                <font><pointsize>13</pointsize><bold>true</bold></font>
               </property>
               <property name="text">
                <string>Gastos: $0.00</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignCenter</set>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <widget class="QGroupBox" name="groupPresupuesto">
          <property name="title">
           <string>📊 Control de Presupuesto Mensual</string>
          </property>
          <layout class="QFormLayout" name="formLayoutPresupuesto">
           <item row="0" column="0">
            <widget class="QLabel" name="lblPres">
             <property name="text">
              <string>Límite Mensual:</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QDoubleSpinBox" name="spinPresupuestoTotal">
             <property name="maximum">
              <double>999999.99</double>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="lblConsumo">
             <property name="text">
              <string>Consumo:</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QProgressBar" name="progressPresupuesto">
             <property name="value">
              <number>0</number>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <widget class="QGroupBox" name="groupRecientes">
          <property name="title">
           <string>🕒 Últimos 5 Movimientos</string>
          </property>
          <layout class="QVBoxLayout">
           <item>
            <widget class="QTableWidget" name="tablaRecientes">
             <property name="maximumHeight">
              <number>160</number>
             </property>
             <property name="editTriggers">
              <enum>QAbstractItemView::NoEditTriggers</enum>
             </property>
             <property name="columnCount">
              <number>4</number>
             </property>
             <column>
              <property name="text"><string>Fecha</string></property>
             </column>
             <column>
              <property name="text"><string>Descripción</string></property>
             </column>
             <column>
              <property name="text"><string>Tipo</string></property>
             </column>
             <column>
              <property name="text"><string>Monto</string></property>
             </column>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <widget class="QLabel" name="labelPlaceholderGrafico">
          <property name="minimumHeight">
           <number>280</number>
          </property>
          <property name="styleSheet">
           <string notr="true">border: 1px dashed #555; border-radius: 10px;</string>
          </property>
          <property name="text">
           <string>Cargando gráfica dinámica...</string>
          </property>
          <property name="alignment">
           <set>Qt::AlignCenter</set>
          </property>
         </widget>
        </item>

        <item>
         <layout class="QHBoxLayout">
          <item>
           <spacer>
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="btnActualizarDash">
            <property name="text">
             <string>🔄 Actualizar</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>

      <widget class="QWidget" name="tabRegistro">
       <attribute name="title">
        <string>➕ Registrar</string>
       </attribute>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QGroupBox" name="groupNuevo">
          <property name="title">
           <string>Detalles del Movimiento</string>
          </property>
          <layout class="QGridLayout" name="gridLayoutNuevo">
           <property name="verticalSpacing">
            <number>15</number>
           </property>
           
           <item row="0" column="0">
            <widget class="QLabel" name="label_f">
             <property name="text"><string>Fecha:</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <layout class="QHBoxLayout">
             <item>
              <widget class="QDateEdit" name="dateFecha">
               <property name="calendarPopup"><bool>true</bool></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnHoy">
               <property name="text"><string>Hoy</string></property>
              </widget>
             </item>
            </layout>
           </item>

           <item row="1" column="0">
            <widget class="QLabel" name="label_d">
             <property name="text"><string>Descripción:</string></property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="txtOriginal">
             <property name="objectName">
              <string>txtDescripcion</string>
             </property>
             <property name="placeholderText">
              <string>Insumos, Sueldo, ...</string>
             </property>
            </widget>
           </item>

           <item row="2" column="0">
            <widget class="QLabel" name="label_m">
             <property name="text"><string>Monto:</string></property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QDoubleSpinBox" name="spinMonto">
             <property name="maximum">
              <double>999999.99</double>
             </property>
            </widget>
           </item>

           <item row="3" column="0">
            <widget class="QLabel" name="label_t">
             <property name="text"><string>Tipo:</string></property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QComboBox" name="comboTipo">
             <item><property name="text"><string>Gasto (-)</string></property></item>
             <item><property name="text"><string>Ingreso (+)</string></property></item>
            </widget>
           </item>

           <item row="4" column="0">
            <widget class="QLabel" name="label_mon">
             <property name="text"><string>Moneda:</string></property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QComboBox" name="comboMoneda">
             <item><property name="text"><string>$ (MXN)</string></property></item>
             <item><property name="text"><string>$ (USD)</string></property></item>
             <item><property name="text"><string>€ (EUR)</string></property></item>
            </widget>
           </item>

           <item row="5" column="0">
            <widget class="QLabel" name="label_c">
             <property name="text"><string>Categoría:</string></property>
            </widget>
           </item>
           <item row="5" column="1">
            <widget class="QComboBox" name="comboCategoria">
             <item><property name="text"><string>Alimentación</string></property></item>
             <item><property name="text"><string>Transporte</string></property></item>
             <item><property name="text"><string>Insumos</string></property></item>
             <item><property name="text"><string>Servicios</string></property></item>
             <item><property name="text"><string>Otros</string></property></item>
            </widget>
           </item>

           <item row="6" column="0">
            <widget class="QLabel" name="label_n">
             <property name="text"><string>Notas:</string></property>
            </widget>
           </item>
           <item row="6" column="1">
            <widget class="QTextEdit" name="txtNotas">
             <property name="maximumHeight"><number>80</number></property>
            </widget>
           </item>

           <item row="7" column="1">
            <layout class="QHBoxLayout">
             <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
             <item>
              <widget class="QPushButton" name="btnLimpiar">
               <property name="text"><string>🧹 Limpiar</string></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnGuardar">
               <property name="text"><string>💾 Guardar</string></property>
               <property name="minimumHeight"><number>40</number></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property></spacer></item>
       </layout>
      </widget>

      <widget class="QWidget" name="tabHistorial">
       <attribute name="title">
        <string>📋 Historial</string>
       </attribute>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QGroupBox" name="groupFiltros">
          <layout class="QHBoxLayout" name="layoutFiltros">
           <item>
            <widget class="QLineEdit" name="txtBuscar">
             <property name="placeholderText"><string>🔎 Buscar...</string></property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="comboFiltroMoneda">
             <item><property name="text"><string>Todas las monedas</string></property></item>
             <item><property name="text"><string>MXN</string></property></item>
             <item><property name="text"><string>USD</string></property></item>
             <item><property name="text"><string>EUR</string></property></item>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="comboFiltro">
             <item><property name="text"><string>Todos los tipos</string></property></item>
             <item><property name="text"><string>Solo Ingresos</string></property></item>
             <item><property name="text"><string>Solo Gastos</string></property></item>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btnLimpiarFiltros">
             <property name="text"><string>🔄 Reset</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>

        <item>
         <widget class="QTableWidget" name="tablaMovimientos">
          <property name="selectionBehavior">
           <enum>QAbstractItemView::SelectRows</enum>
          </property>
          <property name="editTriggers">
           <enum>QAbstractItemView::NoEditTriggers</enum>
          </property>
          <property name="alternatingRowColors">
           <bool>true</bool>
          </property>
          <property name="columnCount">
           <number>8</number>
          </property>
          <column><property name="text"><string>ID</string></property></column>
          <column><property name="text"><string>Fecha</string></property></column>
          <column><property name="text"><string>Descripción</string></property></column>
          <column><property name="text"><string>Categoría</string></property></column>
          <column><property name="text"><string>Tipo</string></property></column>
          <column><property name="text"><string>Monto</string></property></column>
          <column><property name="text"><string>Moneda</string></property></column>
          <column><property name="text"><string>Notas</string></property></column>
         </widget>
        </item>

        <item>
         <layout class="QHBoxLayout" name="layoutBotonesTabla">
          <item><widget class="QPushButton" name="btnEliminar"><property name="text"><string>❌ Eliminar</string></property></widget></item>
          <item><widget class="QPushButton" name="btnEditar"><property name="text"><string>✏️ Editar</string></property></widget></item>
          <item><widget class="QPushButton" name="btnCopiar"><property name="text"><string>📋 Copiar</string></property></widget></item>
          <item><widget class="QPushButton" name="btnExportarCSV"><property name="text"><string>📥 CSV</string></property></widget></item>
          <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
          <item>
           <widget class="QLabel" name="lblSaldo">
            <property name="font">
             <font><pointsize>15</pointsize><bold>true</bold></font>
            </property>
            <property name="text">
             <string>Saldo: $0.00</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>

  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="menuArchivo">
    <property name="title"><string>Archivo</string></property>
    <addaction name="actionImportarCSV"/>
    <addaction name="separator"/>
    <addaction name="actionSalir"/>
   </widget>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>

  <action name="actionImportarCSV"><property name="text"><string>Importar desde CSV...</string></property></action>
  <action name="actionSalir"><property name="text"><string>Salir</string></property></action>

